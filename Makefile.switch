ifeq ($(strip $(DEVKITPRO)),)
$(error DEVKITPRO must point to a devkitPro installation)
endif
include $(DEVKITPRO)/libnx/switch_rules

SWITCH_BUILD := build/switch
SWITCH_CXX := $(DEVKITPRO)/devkitA64/bin/aarch64-none-elf-g++
SWITCH_PORTLIBS := $(DEVKITPRO)/portlibs/switch
SWITCH_SDL := $(SWITCH_PORTLIBS)/bin/sdl2-config
SWITCH_ARCH := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE
SWITCH_FLAGS := $(SWITCH_ARCH) -O2 -std=c++17 -D__SWITCH__ -DGLM_ENABLE_EXPERIMENTAL -ffunction-sections -fdata-sections
SWITCH_FLAGS += -Iclient/include -I$(DEVKITPRO)/libnx/include -I$(SWITCH_PORTLIBS)/include -I$(SWITCH_PORTLIBS)/include/glm $(shell $(SWITCH_SDL) --cflags)
SWITCH_SOURCES := $(wildcard client/src/*.cpp)
SWITCH_OBJECTS := $(patsubst client/src/%.cpp,$(SWITCH_BUILD)/%.o,$(SWITCH_SOURCES))

.PHONY: all
all: $(SWITCH_BUILD)/MineCppClone.nro

$(SWITCH_BUILD)/%.o: client/src/%.cpp
	@mkdir -p $(SWITCH_BUILD)
	$(SWITCH_CXX) $(SWITCH_FLAGS) -MMD -MP -c $< -o $@

$(SWITCH_BUILD)/MineCppClone.elf: $(SWITCH_OBJECTS)
	$(SWITCH_CXX) $(SWITCH_ARCH) -specs=$(DEVKITPRO)/libnx/switch.specs -Wl,--gc-sections $^ -L$(SWITCH_PORTLIBS)/lib -L$(DEVKITPRO)/libnx/lib -lglad $(shell $(SWITCH_SDL) --libs) -o $@

$(SWITCH_BUILD)/MineCppClone.nro: $(SWITCH_BUILD)/MineCppClone.elf $(wildcard client/shaders/* client/textures/*)
	mkdir -p $(SWITCH_BUILD)/romfs
	cp -r client/shaders client/textures $(SWITCH_BUILD)/romfs/
	nacptool --create "C-mine" "C-mine contributors" "0.2.0" $(SWITCH_BUILD)/MineCppClone.nacp
	elf2nro $< $@ --nacp=$(SWITCH_BUILD)/MineCppClone.nacp --romfsdir=$(SWITCH_BUILD)/romfs

-include $(SWITCH_OBJECTS:.o=.d)
